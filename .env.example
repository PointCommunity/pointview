# Public identity for generated links and launch assertions.
POINTVIEW_BASE_URL=https://view.pointatx.org
POINTVIEW_AUDIENCE=pointview

# Server-only dependencies. Use secret references in deployed environments.
DATABASE_URL=postgres://pointview:replace-me@127.0.0.1:5432/pointview
SESSION_SECRET=replace-with-at-least-32-random-characters
CF_ACCESS_TEAM_DOMAIN=https://pointatx.cloudflareaccess.com
CF_ACCESS_AUD=replace-with-cloudflare-access-audience
ATTACHMENT_ROOT=/var/lib/pointview/attachments
GITHUB_APP_ID=replace-with-github-app-id
GITHUB_APP_INSTALLATION_ID=replace-with-installation-id
GITHUB_APP_PRIVATE_KEY=replace-with-pem-secret-reference
OPENAI_API_KEY=replace-with-provider-secret-reference
POINTVIEW_SOURCE_REVISION=development
